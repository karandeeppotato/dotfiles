{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/samurai.txt",
        "color": {
            "1": "red",
            "2": "yellow",
            "3": "white"
        },
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " ",
        "key": {
            "type": "both-1"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "localip",
        "break",
        "colors"
    ]
}
